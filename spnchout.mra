<misterromdescription>
    <name>Super Punch-Out!!</name>
    <setname>spnchout</setname>
    <year>1984</year>
    <manufacturer>Nintendo</manufacturer>
    <category>Arcade</category>
    <rbf>punchout</rbf>

    <!-- Same board as Punch-Out!! (CHP1-01/02), so the image layout is
         identical region for region; only the contents differ, plus the
         protection hardware the core enables when it sees this game.

           0x00000   49152  Z80 program            (maps to 0000-BFFF)
           0x0C000    8192  RP2A03 program         (maps to E000-FFFF)
           0x0E000   16384  gfx1, top bg chars     2bpp planar
           0x12000   16384  gfx2, bottom bg chars  2bpp planar
           0x16000  196608  gfx3, big sprite #1    3bpp planar, gaps read FF
           0x46000   65536  gfx4, big sprite #2    2bpp planar, gaps read FF
           0x56000    3072  colour PROMs (pink set): R,G,B top then R,G,B bottom
           0x56C00   16384  VLM5030 speech data
           0x5AC00         total

         Differences from Punch-Out!!: its own program, character and speech
         ROMs; gfx3's 2u/3u sockets carry 16 KB parts rather than 8 KB (same
         region size, one fewer gap); gfx2 and gfx4 are the same physical ROMs
         as Punch-Out!!. The board adds an RP5C01 real-time clock and an
         RP5H01 one-time PROM on I/O ports 05-07; see docs/hardware.md.

         chs1-b.4c/4d, chp1-b.4a/4b and chp1-v.6p/6n/8p/8n are split into four
         2 KB quarters that land in the order 0, 2, 1, 3 (MAME's ROM_CONTINUE
         chain), which is why each appears as four <part> slices below.
    -->
    <rom index="0" zip="spnchout.zip" md5="8d20ccf061e2457744d9a52523ca21ec">

        <!-- ============ maincpu: Z80 program, 48 KB ============ -->
        <part name="chs1-c.8l" crc="703b9780"/>
        <part name="chs1-c.8k" crc="e13719f6"/>
        <part name="chs1-c.8j" crc="1fa629e8"/>
        <part name="chs1-c.8h" crc="15a6c068"/>
        <part name="chs1-c.8f" crc="4ff3cdd9"/>

        <!-- ============ audiocpu: RP2A03 program, 8 KB ============ -->
        <part name="chp1-c.4k" crc="cb6ef376"/>

        <!-- ============ gfx1: top monitor background chars ============ -->
        <part name="chs1-b.4c" crc="9f2ede2d" offset="0x0000" length="0x0800"/>
        <part name="chs1-b.4c" crc="9f2ede2d" offset="0x1000" length="0x0800"/>
        <part name="chs1-b.4c" crc="9f2ede2d" offset="0x0800" length="0x0800"/>
        <part name="chs1-b.4c" crc="9f2ede2d" offset="0x1800" length="0x0800"/>
        <part name="chs1-b.4d" crc="143ae5c6" offset="0x0000" length="0x0800"/>
        <part name="chs1-b.4d" crc="143ae5c6" offset="0x1000" length="0x0800"/>
        <part name="chs1-b.4d" crc="143ae5c6" offset="0x0800" length="0x0800"/>
        <part name="chs1-b.4d" crc="143ae5c6" offset="0x1800" length="0x0800"/>

        <!-- ============ gfx2: bottom monitor background chars ============ -->
        <part name="chp1-b.4a" crc="c075f831" offset="0x0000" length="0x0800"/>
        <part name="chp1-b.4a" crc="c075f831" offset="0x1000" length="0x0800"/>
        <part name="chp1-b.4a" crc="c075f831" offset="0x0800" length="0x0800"/>
        <part name="chp1-b.4a" crc="c075f831" offset="0x1800" length="0x0800"/>
        <part name="chp1-b.4b" crc="c4cc2b5a" offset="0x0000" length="0x0800"/>
        <part name="chp1-b.4b" crc="c4cc2b5a" offset="0x1000" length="0x0800"/>
        <part name="chp1-b.4b" crc="c4cc2b5a" offset="0x0800" length="0x0800"/>
        <part name="chp1-b.4b" crc="c4cc2b5a" offset="0x1800" length="0x0800"/>

        <!-- ============ gfx3: big sprite #1, three 64 KB planes ============ -->
        <!-- plane 0 (pixel bit 0) -->
        <part name="chs1-v.2r" crc="ff33405d"/>
        <part name="chs1-v.2t" crc="f507818b"/>
        <part name="chs1-v.2u" crc="0995fc95"/>
        <part name="chs1-v.2v" crc="f44d9878"/>
        <part repeat="0x2000">FF</part>
        <!-- plane 1 (pixel bit 1) -->
        <part name="chs1-v.3r" crc="09570945"/>
        <part name="chs1-v.3t" crc="42c6861c"/>
        <part name="chs1-v.3u" crc="bf5d02dd"/>
        <part name="chs1-v.3v" crc="5673f4fc"/>
        <part repeat="0x2000">FF</part>
        <!-- plane 2 (pixel bit 2); socket 4v was never fitted -->
        <part name="chs1-v.4r" crc="8e155758"/>
        <part name="chs1-v.4t" crc="b4e43448"/>
        <part name="chs1-v.4u" crc="74e0d956"/>
        <part repeat="0x4000">FF</part>

        <!-- ============ gfx4: big sprite #2, two 32 KB planes ============ -->
        <!-- plane 0 (pixel bit 0) -->
        <part name="chp1-v.6p" crc="75be7aae" offset="0x0000" length="0x0800"/>
        <part name="chp1-v.6p" crc="75be7aae" offset="0x1000" length="0x0800"/>
        <part name="chp1-v.6p" crc="75be7aae" offset="0x0800" length="0x0800"/>
        <part name="chp1-v.6p" crc="75be7aae" offset="0x1800" length="0x0800"/>
        <part name="chp1-v.6n" crc="daf74de0" offset="0x0000" length="0x0800"/>
        <part name="chp1-v.6n" crc="daf74de0" offset="0x1000" length="0x0800"/>
        <part name="chp1-v.6n" crc="daf74de0" offset="0x0800" length="0x0800"/>
        <part name="chp1-v.6n" crc="daf74de0" offset="0x1800" length="0x0800"/>
        <part repeat="0x4000">FF</part>
        <!-- plane 1 (pixel bit 1) -->
        <part name="chp1-v.8p" crc="4cb7ea82" offset="0x0000" length="0x0800"/>
        <part name="chp1-v.8p" crc="4cb7ea82" offset="0x1000" length="0x0800"/>
        <part name="chp1-v.8p" crc="4cb7ea82" offset="0x0800" length="0x0800"/>
        <part name="chp1-v.8p" crc="4cb7ea82" offset="0x1800" length="0x0800"/>
        <part name="chp1-v.8n" crc="1c0d09aa" offset="0x0000" length="0x0800"/>
        <part name="chp1-v.8n" crc="1c0d09aa" offset="0x1000" length="0x0800"/>
        <part name="chp1-v.8n" crc="1c0d09aa" offset="0x0800" length="0x0800"/>
        <part name="chp1-v.8n" crc="1c0d09aa" offset="0x1800" length="0x0800"/>
        <part repeat="0x4000">FF</part>

        <!-- ============ colour PROMs, pink set ============ -->
        <part name="chs1-b-6e_pink.6e" crc="0ad4d727"/>   <!-- top    R -->
        <part name="chs1-b-6f_pink.6f" crc="86f5cfdb"/>   <!-- top    G -->
        <part name="chs1-b-7f_pink.7f" crc="8bd406f8"/>   <!-- top    B -->
        <part name="chs1-b-7e_pink.7e" crc="4c7e3a67"/>   <!-- bottom R -->
        <part name="chs1-b-8e_pink.8e" crc="ec659313"/>   <!-- bottom G -->
        <part name="chs1-b-8f_pink.8f" crc="8b493c09"/>   <!-- bottom B -->

        <!-- ============ VLM5030 speech data ============ -->
        <part name="chs1-c.6p" crc="ad8b64b8"/>
    </rom>

    <!-- Factory DIP defaults: DSW1 = 0x00, DSW2 = 0x10 -->
    <buttons names="Left Punch,Right Punch,KO Punch,Duck,Coin" default="B,A,Y,X,Select" count="4"/>
</misterromdescription>
