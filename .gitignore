# --- Punch-Out!! project: never commit ROMs, romsets or derived images ---
/mame-romset/
/punchout/
/punchout.zip
*.rom
/build/
/ref/

# MAME-derived analysis output: state dumps hold video/sprite RAM contents and
# the snapshots are renders of ROM graphics. All of it regenerates in a couple
# of minutes from the user's own romset with tools/capture_states.sh.
/artifacts*/
/snap/

# Loose source copies of the Pocket artwork dropped at the repo root. The
# versions that ship live in pkg/pocket/, named for the platform id.
/*.bin

